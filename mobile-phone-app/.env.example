# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT=1mb
MAX_PAGE_SIZE=100
EXPOSE_QUERY_DIAGNOSTICS=false
LOG_LEVEL=info

# MySQL (required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=phonedb_app
DB_PASSWORD=change-me
DB_NAME=phonedb
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Data and browser API
SEED_FILE=../data/phones.csv
NEXT_PUBLIC_API_URL=http://localhost:3001/api
