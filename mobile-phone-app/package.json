{
  "name": "mobile-phone-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "backend": "tsx backend/server.ts",
    "backend:dev": "tsx watch backend/server.ts",
    "migrate": "tsx backend/database/migrate.ts up",
    "migrate:status": "tsx backend/database/migrate.ts status",
    "seed": "tsx backend/database/seed.ts",
    "db:clean": "tsx backend/database/clean.ts",
    "db:setup": "npm run migrate && npm run seed",
    "db:reset:dev": "tsx backend/database/clean.ts --confirm && npm run db:setup"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "mysql2": "^3.24.4",
    "next": "16.3.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
